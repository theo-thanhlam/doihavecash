# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/doihavemoney
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Redis holds sign-in codes (5 minute TTL)
REDIS_URL=redis://localhost:6379

# SMTP for sign-in codes. Defaults match Mailpit from docker-compose.yml.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="DoIHaveMoney <no-reply@doihavemoney.local>"
